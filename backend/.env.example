# O backend lê VARIÁVEIS DE AMBIENTE (não carrega este ficheiro sozinho).
# Defina-as na linha de comandos ou no painel do serviço onde publicar. Todas são opcionais.
EARTHTREND_DATA_DIR=../data
EARTHTREND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://joselio-joao.github.io
EARTHTREND_MIN_YEARS=10
EARTHTREND_MAX_VALUES=20000000
EARTHTREND_MAX_CONCURRENT=2

# Google Earth Engine (opcional). Nunca guardar o JSON da conta de serviço no Git.
EARTHTREND_EE_PROJECT_ID=earth-trend
EARTHTREND_EE_SERVICE_ACCOUNT_JSON=
